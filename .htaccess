# Reindirizza tutto alla cartella public/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /progetto_TecWeb/
  
  # Reindirizza tutto a public/ tranne le chiamate API
  RewriteCond %{REQUEST_URI} !^/progetto_TecWeb/public/
  RewriteCond %{REQUEST_URI} !^/progetto_TecWeb/src/api/
  RewriteRule ^(.*)$ public/$1 [L]
  
  # Le chiamate API vanno direttamente a src/api/
  RewriteRule ^api/(.*)$ src/api/$1 [L]
</IfModule>
